# Admin credentials for Vessel Mission Control
ADMIN_PASSWORD=change-me-to-a-strong-password
AUTH_SECRET=generate-a-random-32-char-string-here

# OpenClaw Gateway integration
# OPENCLAW_GATEWAY_URL=http://localhost:8080
# OPENCLAW_API_TOKEN=your-api-token-here

# OpenClaw paths (defaults shown - override if your setup differs)
# OPENCLAW_DIR=/home/user/.openclaw
# OPENCLAW_WORKSPACE=/home/user/.openclaw/workspace

# Stripe integration (optional — returns mock data if not set)
# Get your secret key from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for testing, sk_live_... for production
# STRIPE_SECRET_KEY=sk_test_your_key_here

# Branding (Vessel Business)
NEXT_PUBLIC_AGENT_NAME=Vessel Command
NEXT_PUBLIC_AGENT_EMOJI=⛵
NEXT_PUBLIC_AGENT_DESCRIPTION=Mission Control for Vessel Business — Navigate expert businesses to success
NEXT_PUBLIC_AGENT_LOCATION=Digital Waters
NEXT_PUBLIC_BIRTH_DATE=2026-02-24
NEXT_PUBLIC_AGENT_AVATAR=/vessel-logo.jpg
NEXT_PUBLIC_OWNER_USERNAME=vessel
NEXT_PUBLIC_OWNER_EMAIL=hello@vessel.business
NEXT_PUBLIC_OWNER_COLLAB_EMAIL=team@vessel.business
NEXT_PUBLIC_TWITTER_HANDLE=@vesselcmd
NEXT_PUBLIC_COMPANY_NAME=VESSEL BUSINESS
